# ─── .env.example ─────────────────────────────────────────────────────────────
# Copy to .env and fill in values. NEVER commit .env to version control.
# Values marked <generated> must be produced securely:
#   JWT_SECRET:        openssl rand -base64 32
#   POSTGRES_PASSWORD: openssl rand -hex 32
#   REDIS_PASSWORD:    openssl rand -hex 32
#   INTERNAL_API_KEY:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.kollegan.ai
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://app.kollegan.ai,https://www.kollegan.ai

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
POSTGRES_DB=kollegan
POSTGRES_USER=kollegan
POSTGRES_PASSWORD=<generated>

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=<generated>

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT_SECRET must be >= 256 bits of randomness (openssl rand -base64 32)
JWT_SECRET=<generated>
INTERNAL_API_KEY=<generated>

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_<from Resend dashboard>
EMAIL_FROM=no-reply@kollegan.ai
# Resend sandbox mode: redirect all emails to this verified address (instead of real recipients)
# RESEND_TEST_TO=your-verified@email.com

# ── Integrations ──────────────────────────────────────────────────────────────
VAPI_WEBHOOK_SECRET=<from Vapi dashboard>
VAPI_API_KEY=<from Vapi dashboard>
GOOGLE_CLIENT_ID=<OAuth client ID>
GOOGLE_CLIENT_SECRET=<OAuth client secret>
GOOGLE_REFRESH_TOKEN=<OAuth refresh token>

# ── Demo ──────────────────────────────────────────────────────────────────────
# UUID of the demo organization. Set after running: pnpm seed:demo-org
DEMO_ORG_ID=<uuid>

# ── Observability (optional) ──────────────────────────────────────────────────
LOG_LEVEL=info
# AXIOM_DATASET=kollegan-prod
# AXIOM_TOKEN=<from Axiom dashboard>
