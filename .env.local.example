# =============================================================
# Grand Hotel Kollegan Demo — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your values.

# Public URL of this Next.js app.
# For local development with ngrok: https://abc123.ngrok-free.app
# For production: your Vercel/server URL
NEXTJS_PUBLIC_URL=http://localhost:3001

# =============================================================
# Auth & Security
# =============================================================

# Shared secret between VAPI and this server.
# Generate with: openssl rand -hex 32
# Set the SAME value in:
#   1. This env var (server-side)
#   2. Each VAPI tool's server.secret field in the dashboard (or assistant-config.json)
VAPI_WEBHOOK_SECRET=your-random-secret-here

# JWT secret for staff authentication (admin dashboard).
# Generate with: openssl rand -hex 64
JWT_SECRET=your-jwt-secret-here
# Local passkey development. Override both when testing another hostname.
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost

# =============================================================
# Database (PostgreSQL 18.2+)
# =============================================================
# Local development example:
DATABASE_URL=postgresql://user:password@localhost:5432/kollegan_db

# Production example (Supabase, Railway, Neon, etc.):
# DATABASE_URL=postgresql://user:password@host:5432/kollegan_db?sslmode=require

# =============================================================
# Cache (Redis 7+)
# =============================================================
# Used for: rate limiting, session management, JWT blacklist
# Local development:
REDIS_URL=redis://localhost:6379

# Production example (Upstash, Railway, etc.):
# REDIS_URL=redis://default:password@host:6379

# =============================================================
# VAPI Web SDK — enables in-browser calling to Elsa
# Get these from https://dashboard.vapi.ai
# =============================================================
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your-vapi-assistant-id

# =============================================================
# Google Calendar Integration
# =============================================================
# 1. Create a Google Cloud project: https://console.cloud.google.com
# 2. Enable the Google Calendar API
# 3. Create a Service Account and download the JSON key
# 4. Share your Google Calendar with the service account email
# 5. Fill in the values below from the service account JSON key

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
