# =============================================================
# Grand Hotel Kollegan Demo — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your values.

# Public URL of this Next.js app.
# For local development with ngrok: https://abc123.ngrok-free.app
# For production: your Vercel/server URL
NEXTJS_PUBLIC_URL=http://localhost:3000

# Optional: shared secret to protect API routes (add as Authorization header from n8n)
# API_SECRET=your-random-secret-here

# Vapi Web SDK — enables in-browser calling to Maja
# Get these from https://dashboard.vapi.ai
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your-vapi-assistant-id

# =============================================================
# n8n Environment Variables (set in your n8n instance, not here)
# =============================================================
# NEXTJS_BASE_URL=https://your-public-url.example.com
# (used by n8n HTTP Request nodes to reach the Next.js API)
