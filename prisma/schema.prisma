// ─────────────────────────────────────────────────────────────────────────────
// Prisma 7 schema — Grand Hotel Kollegan demo
//
// Connection URL lives in prisma.config.ts, not here (Prisma 7 change).
// Table names use the demo_hotel_ prefix via @@map() so the database
// stays unambiguous and generic names like "bookings" are avoided.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Customer Profiles ────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid())
  name      String?
  phone     String?  @unique
  email     String?
  company   String?
  notes     String?
  callCount Int      @default(1)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt

  bookings    HotelBooking[]
  transcripts CallTranscript[]
  crmRecords  CrmRecord[]

  @@index([phone])
  @@index([name])
  @@map("demo_hotel_customers")
}

// ─── Booking Records ──────────────────────────────────────────────────────────
// Model renamed HotelBooking to avoid collision with generic "Booking" types.

model HotelBooking {
  id          String    @id @default(uuid())
  roomId      String
  guestName   String
  checkIn     DateTime?
  checkOut    DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  @@index([roomId])
  @@index([customerId])
  @@index([checkIn, checkOut])
  @@map("demo_hotel_bookings")
}

// ─── Call Transcripts ─────────────────────────────────────────────────────────

model CallTranscript {
  id             String    @id @default(uuid())
  vapiCallId     String?   @unique
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  summary        String?
  bookingsMade   String[]  // room IDs booked during this call
  cancelledRooms String[]  // room IDs cancelled during this call

  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  @@index([vapiCallId])
  @@index([customerId])
  @@map("demo_hotel_call_transcripts")
}

// ─── CRM Records (one per call session) ──────────────────────────────────────

model CrmRecord {
  id          String   @id @default(uuid())
  name        String?
  email       String?
  phone       String?
  company     String?
  notes       String?
  summary     String?
  bookedRooms String[] // room IDs confirmed in this session
  createdAt   DateTime @default(now())

  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  @@index([customerId])
  @@map("demo_hotel_crm_records")
}

// ─── Staff Users (admin dashboard auth) ──────────────────────────────────────

model StaffUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         String    @default("receptionist") // receptionist | manager | admin
  createdAt    DateTime  @default(now())
  lastLogin    DateTime?

  @@index([email])
  @@map("demo_hotel_staff_users")
}
