// ─── Identity / Organization ──────────────────────────────────────────────────
// Multi-tenancy root. Every tenant-owned record has an organizationId here.

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("demo") // demo | starter | growth | enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Two-tier tenancy: internal org (the company) vs customer orgs (each client)
  orgType     String  @default("internal") // internal | customer
  parentOrgId String? // null for internal; customer → internal org id

  // Custom sender email for outgoing offers / notifications
  senderEmail String? // e.g. "sales@mycompany.se" — must be verified in Resend
  senderName  String? // e.g. "Acme AB" — display name in the From header
  emailHeaderConfig String? // JSON config for default visual email header

  // Back-relations — defined in their respective schema files
  customers   Customer[]
  bookings    HotelBooking[]
  transcripts CallTranscript[]
  crmRecords  CrmRecord[]
  workflows   Workflow[]
  leads       Lead[]
  users       User[]
  portal        Portal?
  offers         Offer[]
  offerTemplates OfferTemplate[]
  offerProducts      OfferProduct[]
  productCategories  ProductCategory[]
  companies          Company[]
  conversations Conversation[]
  projects      Project[]
  announcements Announcement[]
  meetings      Meeting[]

  @@index([slug])
  @@index([orgType])
  @@map("org_organizations")
}
