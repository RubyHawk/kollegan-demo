// ─── Identity / Organization ──────────────────────────────────────────────────
// Multi-tenancy root. Every tenant-owned record has an organizationId here.

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("demo") // demo | starter | growth | enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Two-tier tenancy: internal org (the company) vs customer orgs (each client)
  orgType     String  @default("internal") // internal | customer
  parentOrgId String? // null for internal; customer → internal org id

  // Custom sender email for outgoing offers / notifications
  senderEmail String? // e.g. "sales@mycompany.se" — must be verified in Resend
  senderName  String? // e.g. "Acme AB" — display name in the From header
  emailHeaderConfig String? // JSON config for default visual email header
  themeMode String? // default internal app theme mode for org members
  themeAccent String? // default internal app accent theme for org members
  themeFontFamily String? // default internal app font family for org members
  themeFontSize String? // default internal app font size for org members

  // Notification routing — JSON array of NotificationRecipient objects
  // [{ "id": "uuid", "email": "...", "tags": ["offer_signed", "offer_declined"] }]
  notificationRecipients String? @default("[]")

  // Back-relations — defined in their respective schema files
  customers   Customer[]
  demoHotelGuests DemoHotelGuest[]
  bookings    HotelBooking[]
  transcripts CallTranscript[]
  crmRecords  CrmRecord[]
  workflows   Workflow[]
  leads       Lead[]
  leadIntakeForwarders LeadIntakeForwarder[]
  leadIntakeMessages   LeadIntakeMessage[]
  users       User[]
  portal        Portal?
  offers         Offer[]
  offerTemplates OfferTemplate[]
  offerProducts      OfferProduct[]
  productCategories  ProductCategory[]
  companies          Company[]
  conversations Conversation[]
  projects      Project[]
  projectLineItems ProjectLineItem[]
  projectStageEvents ProjectStageEvent[]
  suppliers     Supplier[]
  purchaseOrders PurchaseOrder[]
  purchaseOrderLineItems PurchaseOrderLineItem[]
  announcements Announcement[]
  meetings      Meeting[]
  featureFlags  FeatureFlag[]
  featureFlagAuditEvents FeatureFlagAuditEvent[]
  customFieldDefinitions CustomFieldDefinition[]
  invoices       Invoice[]
  timeEntries    TimeEntry[]
  domains        OrganizationDomain[]
  modules        OrganizationModule[]
  publicSiteSettings PublicSiteSettings?
  restaurantMenuCategories RestaurantMenuCategory[]
  restaurantMenuItems RestaurantMenuItem[]
  ingredients Ingredient[]
  restaurantOpeningHours RestaurantOpeningHour[]
  restaurantEvents RestaurantEvent[]
  restaurantReservationRequests RestaurantReservationRequest[]
  restaurantBusinessDays RestaurantBusinessDay[]
  restaurantOrders RestaurantOrder[]
  restaurantOrderItems RestaurantOrderItem[]
  attendanceShifts AttendanceShift[]
  staffScheduleShifts StaffScheduleShift[]
  checklistTasks ChecklistTask[]
  inventoryNotes InventoryNote[]
  supplierNotes SupplierNote[]

  @@index([slug])
  @@index([orgType])
  @@map("org_organizations")
}
