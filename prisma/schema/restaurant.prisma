// ─── Restaurant Public Content ────────────────────────────────────────────────
// Tenant-owned restaurant website content and simple booking requests.
// Table prefix: rst_*

// Shared ingredient catalog. Categories are a global reference table; ingredients
// are global (organizationId NULL = seeded library shared by every tenant) or
// tenant-custom (organizationId set). Dishes reference catalog entries by id but
// also snapshot emoji/name/unit on the menu item for stable display.
model IngredientCategory {
  id        String   @id // stable slug used as primary key, e.g. "vegetables"
  name      String
  emoji     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  ingredients Ingredient[]

  @@map("rst_ingredient_categories")
}

model Ingredient {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String? // NULL = global seeded catalog; set = tenant-custom
  categoryId     String
  slug           String
  name           String
  emoji          String?
  defaultUnit    String?
  aliases        String[]  @default([]) // synonyms (incl. english) for search
  allergens      String[]  @default([]) // EU allergen codes
  isActive       Boolean   @default(true)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  deletedAt      DateTime?

  category     IngredientCategory @relation(fields: [categoryId], references: [id])
  organization Organization?      @relation(fields: [organizationId], references: [id])

  @@index([categoryId])
  @@index([organizationId])
  @@index([name])
  @@map("rst_ingredients")
}

model RestaurantMenuCategory {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  name           String
  description    String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  deletedAt      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id])
  items        RestaurantMenuItem[]

  @@index([organizationId, sortOrder])
  @@index([deletedAt])
  @@map("rst_menu_categories")
}

model RestaurantMenuItem {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  categoryId     String
  name           String
  description    String?
  priceCents     Int?
  currency       String    @default("SEK")
  imageUrl       String?
  allergens      String[]  @default([])
  tags           String[]  @default([])
  ingredients    Json?
  variants       Json?
  modifierGroups Json?
  kitchenStation String?
  isAvailable    Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  deletedAt      DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id])
  category     RestaurantMenuCategory @relation(fields: [categoryId], references: [id])

  @@index([organizationId, categoryId, sortOrder])
  @@index([organizationId, isAvailable])
  @@index([deletedAt])
  @@map("rst_menu_items")
}

model RestaurantOpeningHour {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  dayOfWeek      Int      // 1 = Monday, 7 = Sunday
  opensAt        String?
  closesAt       String?
  isClosed       Boolean  @default(false)
  label          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, dayOfWeek])
  @@map("rst_opening_hours")
}

model RestaurantEvent {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  isPublished    Boolean   @default(false)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, startsAt])
  @@index([organizationId, isPublished])
  @@index([deletedAt])
  @@map("rst_events")
}

model RestaurantReservationRequest {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  guestName      String
  guestEmail     String?
  guestPhone     String?
  partySize      Int
  requestedAt    DateTime
  message        String?
  status         String    @default("new") // new | confirmed | declined | cancelled
  handledBy      String?
  handledAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, requestedAt])
  @@index([organizationId, status])
  @@index([deletedAt])
  @@map("rst_reservation_requests")
}

model RestaurantBusinessDay {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  businessDate   DateTime
  status         String    @default("open") // open | closed
  openedBy       String?
  openedAt       DateTime  @default(now())
  closedBy       String?
  closedAt       DateTime?
  openingNote    String?
  closingNote    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  deletedAt      DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id])
  orders       RestaurantOrder[]

  @@index([organizationId, businessDate])
  @@index([organizationId, status])
  @@index([deletedAt])
  @@map("rst_business_days")
}

model RestaurantOrder {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId  String
  businessDayId   String?
  orderNumber     Int
  source          String    @default("portal") // portal | public
  status          String    @default("new") // new | preparing | ready | completed | cancelled
  paymentStatus   String    @default("unpaid") // unpaid | paid | refunded
  paymentMethod   String?   // cash | card | swish | other
  fulfillmentType String    @default("takeaway") // takeaway | dine_in | counter | booking_linked | delivery
  customerName    String?
  customerPhone   String?   // public online orders: contact number for the kitchen
  deliveryAddress String?   // public online orders: set when fulfillmentType = delivery
  tableLabel      String?
  bookingReference String?
  note            String?
  subtotalCents   Int       @default(0)
  discountCents   Int       @default(0)
  taxCents        Int       @default(0)
  taxRateBps      Int       @default(1200)
  totalCents      Int       @default(0)
  currency        String    @default("SEK")
  isHeld          Boolean   @default(false)
  kotStatus       String    @default("not_sent") // not_sent | sent | printed
  sentToKitchenAt DateTime?
  printedAt       DateTime?
  printCount      Int       @default(0)
  paidAt          DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  deletedAt       DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id])
  businessDay  RestaurantBusinessDay? @relation(fields: [businessDayId], references: [id])
  items        RestaurantOrderItem[]

  @@unique([businessDayId, orderNumber])
  @@index([organizationId, businessDayId])
  @@index([organizationId, status])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, createdAt])
  @@index([deletedAt])
  @@map("rst_orders")
}

model RestaurantOrderItem {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  orderId        String
  menuItemId     String?
  name           String
  quantity       Int      @default(1)
  variantName    String?
  variantPriceCents Int?
  selectedModifiers Json?
  modifierTotalCents Int    @default(0)
  unitPriceCents Int      @default(0)
  lineTotalCents Int      @default(0)
  note           String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  order        RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, orderId])
  @@index([menuItemId])
  @@map("rst_order_items")
}
