// ─── Projects / Delivery Workflow ─────────────────────────────────────────────
// Generic domain. Table prefix: prj_*

enum ProjectStage {
  details
  ordered
  arrived
  in_progress
  completed
}

model Project {
  id                    String       @id @default(uuid())
  organizationId        String
  customerId            String
  offerId               String
  name                  String
  stage                 ProjectStage @default(details)
  offerNumber           Int?
  offerAcceptedAt       DateTime?
  priceDisplayMode      String       @default("exclusive")
  totalExVat            Float        @default(0)
  totalIncVat           Float        @default(0)
  siteAddress           String?
  sitePostalCode        String?
  siteCity              String?
  siteCountry           String?      @default("SE")
  squareMeters          Float?
  objectType            String?
  objectDescription     String?
  accessNotes           String?
  wishedInstallDate     DateTime?
  wishedInstallDateText String?
  onsiteContactName     String?
  onsiteContactPhone    String?
  onsiteContactEmail    String?
  internalNotes         String?
  customFields          Json?         // org-defined extra fields — keyed by CustomFieldDefinition.key
  createdBy             String?
  completedAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  organization   Organization        @relation(fields: [organizationId], references: [id])
  customer       Customer            @relation(fields: [customerId], references: [id])
  offer          Offer               @relation(fields: [offerId], references: [id])
  lineItems      ProjectLineItem[]
  purchaseOrders PurchaseOrder[]
  stageEvents    ProjectStageEvent[]
  timeEntries    TimeEntry[]

  @@unique([organizationId, offerId])
  @@index([organizationId, stage])
  @@index([organizationId, customerId])
  @@index([organizationId, createdAt])
  @@index([deletedAt])
  @@map("prj_projects")
}

model ProjectLineItem {
  id                    String   @id @default(uuid())
  organizationId        String
  projectId             String
  sourceOfferLineItemId String?
  sourceProductId       String?
  productName           String
  description           String
  quantity              Float
  unit                  String   @default("st")
  unitPrice             Float
  vatRate               Float   @default(0.25)
  discount              Float   @default(0)
  lineTotalExVat        Float   @default(0)
  lineTotalIncVat       Float   @default(0)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())

  organization           Organization            @relation(fields: [organizationId], references: [id])
  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  purchaseOrderLineItems PurchaseOrderLineItem[]

  @@index([organizationId, projectId])
  @@index([projectId, sortOrder])
  @@map("prj_line_items")
}

model ProjectStageEvent {
  id             String        @id @default(uuid())
  organizationId String
  projectId      String
  fromStage      ProjectStage?
  toStage        ProjectStage
  actorId        String?
  reason         String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
  @@index([organizationId, toStage])
  @@map("prj_stage_events")
}

// ─── Time Entry ───────────────────────────────────────────────────────────────
// Staff log hours against a project. Billable entries can be exported to an
// invoice line item. invoiceId is set when the entry has been billed.

model TimeEntry {
  id             String    @id @default(uuid())
  organizationId String
  projectId      String?   // prj_projects.id — optional (non-project time)
  userId         String    // usr_users.id
  date           DateTime  @db.Date
  hours          Float
  description    String?
  billable       Boolean   @default(true)
  invoiceId      String?   // inv_invoices.id — set when billed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  project          Project?          @relation(fields: [projectId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id])
  invoiceLineItems InvoiceLineItem[] @relation("TimeEntryLineItem")

  @@index([organizationId, projectId])
  @@index([organizationId, userId, date])
  @@index([organizationId, billable, invoiceId])
  @@index([deletedAt])
  @@map("prj_time_entries")
}
