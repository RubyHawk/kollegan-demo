// ─── Offers / Quotation Builder ───────────────────────────────────────────────
// Supporting domain. Table prefix: off_*

// ─── Offer Template ───────────────────────────────────────────────────────────
// WYSIWYG-authored templates with {{placeholder}} variables.
// Content stored as TipTap JSON string; rendered to HTML at offer-send time.

model OfferTemplate {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  content        String    // TipTap JSON stored as serialized string
  createdBy      String    // User.id
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  offers       Offer[]

  @@index([organizationId, createdAt])
  @@index([deletedAt])
  @@map("off_templates")
}

model Offer {
  id               String    @id @default(uuid())
  organizationId   String
  title            String
  status           String    @default("draft") // draft | sent | viewed | accepted | declined | expired
  recipientName    String
  recipientEmail   String
  recipientCompany String?
  notes            String?
  validUntil       DateTime
  createdBy        String    // User.id

  // Computed totals (SEK, stored for fast list queries)
  totalExVat  Float @default(0)
  totalIncVat Float @default(0)

  // Sequential offer number (assigned on first send, e.g. 2026-001)
  offerNumber Int?

  // Reminder tracking
  reminderSentAt DateTime?
  reminderCount  Int       @default(0)

  // Lifecycle timestamps
  sentAt     DateTime?
  viewedAt   DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?

  // Template & generated document
  templateId        String?
  generatedDocument String?   // immutable HTML snapshot, set at sendOffer time
  signatureImage    String?   // data URL of recipient's e-signature
  publicToken       String    @unique @default(uuid()) // used in public signing URL
  publicTokenExpiresAt DateTime?  // set to sentAt + 30 days

  // Cross-domain links
  leadId     String?   // lead_leads.id
  customerId String?   // crm_customers.id

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  template     OfferTemplate? @relation(fields: [templateId], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id])
  lineItems    OfferLineItem[]

  @@unique([organizationId, offerNumber])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, recipientEmail])
  @@index([deletedAt])
  @@map("off_offers")
}

model OfferLineItem {
  id          String  @id @default(uuid())
  offerId     String
  description String
  quantity    Float
  unitPrice   Float              // SEK, ex VAT
  vatRate     Float  @default(0.25) // 0.25 = 25%
  discount    Float? @default(0)   // percentage 0–100
  sortOrder   Int    @default(0)

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@map("off_line_items")
}

// ─── Product / Service Library ────────────────────────────────────────────────
// Reusable line-item presets for fast offer creation.

model OfferProduct {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  unitPrice      Float
  vatRate        Float     @default(0.25)  // 0.25 = 25%
  unit           String?                   // "st", "tim", "mån", etc.
  createdBy      String                    // User.id
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([deletedAt])
  @@map("off_products")
}
