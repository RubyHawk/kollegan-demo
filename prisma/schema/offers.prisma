// ─── Offers / Quotation Builder ───────────────────────────────────────────────
// Supporting domain. Table prefix: off_*

// ─── Offer Template ───────────────────────────────────────────────────────────
// WYSIWYG-authored templates with {{placeholder}} variables.
// Content stored as TipTap JSON string; rendered to HTML at offer-send time.

model OfferTemplate {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  content        String    // TipTap JSON stored as serialized string
  emailSubject      String?   // Custom email subject (supports {{placeholder}} variables)
  emailBody         String?   // Custom email body HTML (supports {{placeholder}} variables)
  emailHeaderConfig String?   // JSON config for visual email header (logo, colors, text)
  createdBy         String    // User.id
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  offers       Offer[]

  @@index([organizationId, createdAt])
  @@index([deletedAt])
  @@map("off_templates")
}

model Offer {
  id               String    @id @default(uuid())
  organizationId   String
  title            String
  status           String    @default("draft") // draft | sent | viewed | accepted | declined | expired
  recipientName    String
  recipientEmail   String
  recipientCompany String?
  notes            String?
  validUntil       DateTime
  createdBy        String    // User.id

  // Computed totals (SEK, stored for fast list queries)
  totalExVat  Float @default(0)
  totalIncVat Float @default(0)

  // Sequential offer number (assigned on first send, e.g. 2026-001)
  offerNumber Int?

  // Reminder tracking
  reminderSentAt DateTime?
  reminderCount  Int       @default(0)

  // Lifecycle timestamps
  sentAt     DateTime?
  viewedAt   DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?

  // Template & generated document
  templateId        String?
  generatedDocument String?   // immutable HTML snapshot, set at sendOffer time
  emailSubject      String?   // Custom email subject (snapshot, set at sendOffer time)
  emailBody         String?   // Custom email body HTML (snapshot, set at sendOffer time)
  emailHeaderConfig String?   // JSON config for visual email header (logo, colors, text)
  signatureImage    String?   // data URL of recipient's e-signature
  signerName        String?   // name typed by the signer at signing time
  signatureMethod   String    @default("canvas")  // "canvas" (SES) | "bankid" (AdES) — future
  publicToken       String    @unique @default(uuid()) // used in public signing URL
  publicTokenExpiresAt DateTime?  // set to sentAt + 30 days

  // Validity window — user picks from preset options (7/14/30/60/90 days)
  // validUntil is recomputed as sentAt + validityDays when the offer is sent
  validityDays      Int       @default(30)

  // Company (brand / selling entity)
  companyId  String?   // off_companies.id

  // Cross-domain links
  leadId     String?   // lead_leads.id
  customerId String?   // crm_customers.id

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  template     OfferTemplate? @relation(fields: [templateId], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id])
  company      Company?        @relation(fields: [companyId], references: [id])
  lineItems    OfferLineItem[]

  @@unique([organizationId, offerNumber])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt]) // composite: filtered tab views + sort
  @@index([organizationId, recipientEmail])
  @@index([deletedAt])
  @@map("off_offers")
}

model OfferLineItem {
  id          String  @id @default(uuid())
  offerId     String
  description String
  quantity    Float
  unitPrice   Float              // SEK, ex VAT
  vatRate     Float  @default(0.25) // 0.25 = 25%
  discount    Float? @default(0)   // percentage 0–100
  sortOrder   Int    @default(0)

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@map("off_line_items")
}

// ─── Product / Service Library ────────────────────────────────────────────────
// Reusable line-item presets for fast offer creation.

model OfferProduct {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  unitPrice      Float
  vatRate        Float     @default(0.25)  // 0.25 = 25%
  unit           String?                   // "st", "tim", "mån", etc.
  sku            String?                   // internal product code
  category       String?                   // free-text grouping label
  categoryId     String?
  imageUrl       String?                   // CDN URL for product thumbnail
  isActive       Boolean   @default(true)  // soft toggle — hides from pickers without deletion
  minQuantity    Float?                    // optional floor for qty in offer picker
  maxQuantity    Float?                    // optional ceiling for qty in offer picker
  createdBy      String                    // User.id
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  categoryNode ProductCategory? @relation("OfferProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([organizationId, category])
  @@index([organizationId, categoryId])
  @@index([organizationId, isActive, name])
  @@index([organizationId, createdAt])
  @@index([deletedAt])
  @@map("off_products")
}

model ProductCategory {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  parentId       String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  parent       ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     ProductCategory[] @relation("ProductCategoryTree")
  products     OfferProduct[]    @relation("OfferProductCategory")

  @@index([organizationId, parentId, name])
  @@index([deletedAt])
  @@map("off_product_categories")
}

// ─── Company ──────────────────────────────────────────────────────────────────
// Represents a selling entity / brand (NOT the SaaS tenant Organisation).
// Scopes offers, templates, and product libraries per brand.
// Example: org "Kollegan AB" manages brands "Soleria" and "Nordhem".

model Company {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  orgNumber      String?   // Swedish org number, e.g. "556677-8899"
  website        String?
  logoUrl        String?
  industry       String?
  notes          String?
  createdBy      String    // User.id
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id])
  offers         Offer[]

  @@index([organizationId, name])
  @@index([deletedAt])
  @@map("off_companies")
}
