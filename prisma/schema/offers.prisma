// ─── Offers / Quotation Builder ───────────────────────────────────────────────
// Supporting domain. Table prefix: off_*

// ─── Offer Template ───────────────────────────────────────────────────────────
// WYSIWYG-authored templates with {{placeholder}} variables.
// Content stored as TipTap JSON string; rendered to HTML at offer-send time.

model OfferTemplate {
  id             String    @id @default(uuid())
  organizationId String
  companyId      String?
  name           String
  content        String    // TipTap JSON stored as serialized string
  emailSubject      String?   // Custom email subject (supports {{placeholder}} variables)
  emailBody         String?   // Custom email body HTML (supports {{placeholder}} variables)
  emailHeaderConfig String?   // JSON config for visual email header (logo, colors, text)
  createdBy         String    // User.id
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  company      Company?     @relation(fields: [companyId], references: [id])
  offers       Offer[]

  @@index([organizationId, companyId, createdAt])
  @@index([deletedAt])
  @@map("off_templates")
}

model Offer {
  id               String    @id @default(uuid())
  organizationId   String
  title            String
  status           String    @default("draft") // draft | sent | viewed | accepted | declined | expired
  priceDisplayMode String    @default("exclusive") // exclusive | inclusive
  recipientName    String
  recipientEmail   String
  recipientCompany String?
  notes            String?
  validUntil       DateTime
  createdBy        String    // User.id

  // Computed totals (SEK, stored for fast list queries)
  totalExVat  Float @default(0)
  totalIncVat Float @default(0)

  // Sequential offer number (assigned on first send, e.g. 2026-001)
  offerNumber Int?

  // Reminder tracking
  reminderSentAt DateTime?
  reminderCount  Int       @default(0)

  // Lifecycle timestamps
  sentAt     DateTime?
  viewedAt   DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?

  // Template & generated document
  templateId        String?
  generatedDocument String?   // immutable HTML snapshot, set at sendOffer time
  generatedPdf      Bytes?    // persistent public PDF snapshot bytes, regenerated when fingerprint changes
  generatedPdfFingerprint String? // fingerprint of the stored public PDF variant
  emailSubject      String?   // Custom email subject (snapshot, set at sendOffer time)
  emailBody         String?   // Custom email body HTML (snapshot, set at sendOffer time)
  emailHeaderConfig String?   // JSON config for visual email header (logo, colors, text)
  signatureImage    String?   // data URL of recipient's e-signature
  signerName        String?   // name typed by the signer at signing time
  signatureMethod   String    @default("canvas")  // "canvas" (SES) | "bankid" (AdES) — future
  publicToken       String    @unique @default(uuid()) // used in public signing URL
  publicTokenExpiresAt DateTime?  // set to sentAt + 30 days

  // Validity window — user picks from preset options (7/14/30/60/90 days)
  // validUntil is recomputed as sentAt + validityDays when the offer is sent
  validityDays      Int       @default(30)

  // Company (brand / selling entity)
  companyId  String?   // off_companies.id

  // Cross-domain links
  leadId     String?   // lead_leads.id
  customerId String?   // crm_customers.id

  customFields Json?   // org-defined extra fields — keyed by CustomFieldDefinition.key

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  template     OfferTemplate? @relation(fields: [templateId], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id])
  company      Company?        @relation(fields: [companyId], references: [id])
  customer     Customer?       @relation(fields: [customerId], references: [id])
  lineItems    OfferLineItem[]
  projects     Project[]

  @@unique([organizationId, offerNumber])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt]) // composite: filtered tab views + sort
  @@index([organizationId, recipientEmail])
  @@index([organizationId, customerId])
  @@index([deletedAt])
  @@map("off_offers")
}

model OfferLineItem {
  id          String  @id @default(uuid())
  offerId     String
  description String
  quantity    Float
  unitPrice   Float              // SEK, ex VAT
  vatRate     Float  @default(0.25) // 0.25 = 25%
  discount    Float? @default(0)   // percentage 0–100
  productId   String?
  unit        String?
  sortOrder   Int    @default(0)

  offer   Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product OfferProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([offerId])
  @@index([productId])
  @@map("off_line_items")
}

// ─── Product Category ─────────────────────────────────────────────────────────
// Two-level category tree: main categories (parentId = null) → subcategories.
// Products link to a leaf category (subcategory or standalone main category).

model ProductCategory {
  id             String    @id @default(uuid())
  organizationId String
  companyId      String?
  name           String
  parentId       String?   // null = main/top-level category; set = subcategory

  parent         ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       ProductCategory[] @relation("CategoryTree")
  products       OfferProduct[]
  company        Company?          @relation(fields: [companyId], references: [id])

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, companyId, parentId, name])
  @@index([organizationId, companyId, parentId])
  @@index([deletedAt])
  @@map("off_product_categories")
}

// ─── Product / Service Library ────────────────────────────────────────────────
// Reusable line-item presets for fast offer creation.

model OfferProduct {
  id             String    @id @default(uuid())
  organizationId String
  companyId      String?
  name           String
  description    String?
  unitPrice      Float
  vatRate        Float     @default(0.25)  // 0.25 = 25%
  unit           String?                   // "st", "tim", "mån", etc.
  sku            String?                   // internal product code
  category       String?                   // DEPRECATED: free-text label, kept for data migration
  categoryId     String?                   // FK → off_product_categories
  imageUrl       String?                   // CDN URL for product thumbnail
  isActive       Boolean   @default(true)  // soft toggle — hides from pickers without deletion
  sharedAcrossOrg Boolean  @default(false) // true = visible to all companies in the org
  minQuantity    Float?                    // optional floor for qty in offer picker
  maxQuantity    Float?                    // optional ceiling for qty in offer picker
  customFields   Json?                     // org-defined extra fields
  createdBy      String                    // User.id
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  productCategory  ProductCategory?  @relation(fields: [categoryId], references: [id])
  company          Company?          @relation(fields: [companyId], references: [id])
  lineItems        OfferLineItem[]
  invoiceLineItems InvoiceLineItem[]

  @@index([organizationId, companyId, categoryId])
  @@index([organizationId, companyId, category])
  @@index([organizationId, companyId, isActive, name])
  @@index([organizationId, createdAt])
  @@index([deletedAt])
  @@map("off_products")
}

// ─── Company ──────────────────────────────────────────────────────────────────
// Represents a selling entity / brand (NOT the SaaS tenant Organisation).
// Scopes offers, templates, and product libraries per brand.
// Example: org "Kollegan AB" manages brands "Soleria" and "Nordhem".

model Company {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  orgNumber      String?   // Swedish org number, e.g. "556677-8899"
  addressLine1   String?
  addressLine2   String?
  postalCode     String?
  city           String?
  region         String?
  country        String?
  website        String?
  logoUrl        String?
  senderEmail    String?
  senderName     String?
  emailHeaderConfig String?
  industry       String?
  notes          String?
  customFields   Json?     // org-defined extra fields
  // Localisation & tax — set per brand/company
  currency       String    @default("SEK") // "SEK"|"NOK"|"DKK"|"EUR"
  vatNumber      String?                   // e.g. SE556677-8899 / NO123456789MVA
  defaultVatRate Float     @default(0.25)  // company default, used as line-item pre-fill
  createdBy      String    // User.id
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id])
  offers         Offer[]
  templates      OfferTemplate[]
  products       OfferProduct[]
  productCategories ProductCategory[]
  members        CompanyMember[]
  invoices       Invoice[]

  @@index([organizationId, name])
  @@index([deletedAt])
  @@map("off_companies")
}

model CompanyMember {
  id        String   @id @default(uuid())
  companyId  String
  userId     String
  role       String   @default("staff") // staff | admin
  createdAt  DateTime @default(now())
  grantedBy  String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, role])
  @@map("off_company_members")
}
